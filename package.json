{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Playwright journeys for registration and product discovery",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:helpers": "playwright test --config=playwright.checks.config.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report playwright-report/e2e",
    "report:helpers": "playwright show-report playwright-report/checks"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "dotenv": "18.0.9"
  }
}
